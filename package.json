{
  "name": "dsh-temporary-chat",
  "version": "0.2.0",
  "description": "DSH Web plugin: ChatGPT-style temporary chat (no project needed, not persisted, gone on close)",
  "license": "MIT",
  "author": "Xinyu-lumos",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Xinyu-lumos/dsh-temporary-chat"
  },
  "homepage": "https://github.com/Xinyu-lumos/dsh-temporary-chat#readme",
  "bugs": {
    "url": "https://github.com/Xinyu-lumos/dsh-temporary-chat/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "bin": {
    "dsh-temporary-chat-patch": "./scripts/apply-patch.mjs"
  },
  "scripts": {
    "test": "node --test",
    "patch": "node scripts/apply-patch.mjs apply",
    "unpatch": "node scripts/apply-patch.mjs unpatch",
    "status": "node scripts/apply-patch.mjs status"
  },
  "files": [
    "index.js",
    "lib/",
    "scripts/",
    "test/",
    "cordis.patch.yml",
    ".github/workflows/",

    "README.md",
    "README.zh.md",
    "CHANGES.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "temporary-chat",
    "ephemeral",
    "chatgpt",
    "临时聊天"
  ]
}
